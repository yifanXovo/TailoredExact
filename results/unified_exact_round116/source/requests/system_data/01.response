.2 1.2 1.6 3.8 1.6 7s2.6 5.8 5.8 5.8z"></path></g><g fill-rule="evenodd" clip-rule="evenodd" fill="#06f"><path d="M22.6 0H7.4c-3.9 0-7 3.1-7 7s3.1 7 7 7h15.2c3.9 0 7-3.1 7-7s-3.2-7-7-7zm-21 7c0-3.2 2.6-5.8 5.8-5.8h9.9l-3.1 11.6H7.4c-3.2 0-5.8-2.6-5.8-5.8z"></path></g><g fill="#fff"><path d="M24.6 4c.2.2.2.6 0 .8L22.5 7l2.2 2.2c.2.2.2.6 0 .8-.2.2-.6.2-.8 0l-2.2-2.2-2.2 2.2c-.2.2-.6.2-.8 0-.2-.2-.2-.6 0-.8L20.8 7l-2.2-2.2c-.2-.2-.2-.6 0-.8.2-.2.6-.2.8 0l2.2 2.2L23.8 4c.2-.2.6-.2.8 0z"></path></g><g fill="#06f"><path d="M12.7 4.1c.2.2.3.6.1.8L8.6 9.8c-.1.1-.2.2-.3.2-.2.1-.5.1-.7-.1L5.4 7.7c-.2-.2-.2-.6 0-.8.2-.2.6-.2.8 0L8 8.6l3.8-4.5c.2-.2.6-.2.9 0z"></path></g></svg></a></div><span class="_7EGihq_tinyContent"><span data-testid="core-ui-spacer" class="sc-38fb062f-6 frHLOf"></span><span>© Lyft, Inc. <!-- -->2026</span></span></div></span></div></div></div><span data-testid="core-ui-spacer" class="sc-38fb062f-6 kXrFwq"></span></footer></div></div></div><script id="__NEXT_DATA__" type="application/json" crossorigin="anonymous">{"props":{"pageProps":{"i18n":{"page":{}},"tbsPageData":{"componentType":"Page","id":"6bJmQrwMDGHPjGnAivs0t1","displayName":"Cabi: System Data","path":"__tbs/capitalbikeshare/system-data","isPublished":true,"title":"System Data | Capital Bikeshare","description":"Developers, engineers, statisticians and academics can find and download data on Capital Bikeshare membership, ridership and trip histories.\n","sharingImage":{"src":"//images.ctfassets.net/p6ae3zqfb1e3/6tNlSJ1OTqOUIMkVhMstxI/947d342197e7af7b65cac93ba56ac090/CaBi_og_sharing_image.jpg","alt":"","width":1230,"height":600},"components":[{"componentType":"Paragraph","id":"T4S8p5zGWgj5aetlVIldz","displayName":"System Data","header":"System Data","content":"Where do Capital Bikeshare riders go? When do they ride? How far do they go? Which stations are most popular? What days of the week are most rides taken on? We've heard all of these questions since we launched in 2010, and we're glad to provide the data that shows you the answers from our first trip to today.\n\nWe invite developers, engineers, statisticians, artists, academics and other interested members of the public to use the data we provide for analysis, development, visualization or whatever else moves you.\n\nThis data is provided according to the [Capital Bikeshare Data License Agreement](https://www.capitalbikeshare.com/data-license-agreement).","hideHeaderLine":true},{"componentType":"Paragraph","id":"4WcRwcL6Zkh0GHstUv5IgQ","displayName":"Trip History Data","header":"Trip History Data","content":"Each month, we publish [downloadable files](https://s3.amazonaws.com/capitalbikeshare-data/index.html) of Capital Bikeshare trip data. The data includes:\n\n- Duration – Duration of trip\n- Start Date – Includes start date and time\n- End Date – Includes end date and time\n- Start Station – Includes starting station name and number\n- End Station – Includes ending station name and number\n- Bike Number – Includes ID number of bike used for the trip\n- Member Type – Indicates whether user was a \"registered\" member (Annual Member, 30-Day Member or Day Key Member) or a \"casual\" rider (Single Trip, 24-Hour Pass, 3-Day Pass or 5-Day Pass)\n- \nThis data has been processed to remove trips that are taken by staff as they service and inspect the system, trips that are taken to/from any of our “test” stations at our warehouses and any trips lasting less than 60 seconds (potentially false starts or users trying to re-dock a bike to ensure it's secure).\n\nNOTE: The 3-Day Membership replaced the 5-Day Membership in Fall 2011","hideHeaderLine":true,"ctaHref":"https://s3.amazonaws.com/capitalbikeshare-data/index.html","ctaText":"Download Capital Bikeshare trip history data"},{"componentType":"Paragraph","id":"5tb73Yh690InrQ0j7C0a6M","displayName":"Real-Time Data","header":"Real-Time Data","content":"Capital Bikeshare publishes real-time system data in [General Bikeshare Feed Specification](https://github.com/NABSA/gbfs/blob/master/gbfs.md) format.","hideHeaderLine":true,"ctaHref":"https://gbfs.capitalbikeshare.com/gbfs/2.3/gbfs.json","ctaText":"Use our data"},{"componentType":"Paragraph","id":"39nuPVgyR9BRVVGHQofdUi","displayName":"Expansion Plan Data","header":"Expansion Plan Data","content":"Capital Bikeshare conducted a development plan survey every few years to assess usage trends and [expansion plans](https://d21xlh2maitm24.cloudfront.net/wdc/ExpansionPlan_Final_KML.ZIP?mtime=20200512123328). The proposed expansion plan is available to download as a KML file.\n\n__Member Surveys__\nCapital Bikeshare conducts biannual membership surveys to assess how people use the system and what impact it has on their lives and our communities. The results and reports from these surveys are available below:\n\n2016\n[2016 Capital Bikeshare Member Survey Report](https://d21xlh2maitm24.cloudfront.net/wdc/Capital-Bikeshare_2016MemberSurvey_Final-Report.pdf?mtime=20170303165531)\n\n[2016 Capital Bikeshare Member Survey Executive Summary](https://d21xlh2maitm24.cloudfront.net/wdc/Capital-Bikeshare_2016MemberSurvey_Executive-Summary.pdf?mtime=20170303165533)\n\n2014\n[2014 Capital Bikeshare Member Survey Report](https://d21xlh2maitm24.cloudfront.net/wdc/cabi-2014surveyreport.pdf?mtime=20161206135936)\n\n[2014 Capital Bikeshare Member Survey Executive Summary](https://d21xlh2maitm24.cloudfront.net/wdc/cabi-2014surveyreport-execsummary.pdf?mtime=20161206135937)\n\n2012\n[2012 Capital Bikeshare Member Survey Report](https://d21xlh2maitm24.cloudfront.net/wdc/cabi-2012surveyreport.pdf?mtime=20161206135939)\n\n[2012 Capital Bikeshare Member Survey Executive Summary](https://d21xlh2maitm24.cloudfront.net/wdc/cabi-2012surveyreport-execsum-5-15-13-revtitle.pdf?mtime=20161206135941)\n\n[Health Implications of Capital Bikeshare](https://d21xlh2maitm24.cloudfront.net/wdc/v4c_capstone_report_final.pdf?mtime=20161206144453)\n\n2011\n[2011 Capital Bikeshare Member Survey](https://d21xlh2maitm24.cloudfront.net/wdc/Capital-Bikeshare-SurveyReport-Final.pdf?mtime=20161206135935)\n\n[2011 Capital Bikeshare Survey Executive Summary](https://d21xlh2maitm24.cloudfront.net/wdc/Capital_Bikeshare_2011_Survey_Executive_Summary.pdf?mtime=20161206135934)\n\nUpdated on December 6, 2016.","hideHeaderLine":true}]},"tbsCommonData":{"componentType":"bikeshareWebsite","id":"7qLW1LTPbNctwxVU0bfGdi","displayName":"capitalbikeshare","brand":"capitalbikeshare","headerLinks":{"componentType":"LinkList","id":"1HPlV0r30eUcsdUAjwzcQL","displayName":"CaBi Header Links","entries":[{"text":"Ride experience","href":"/how-it-works","onBikesharefe":false},{"text":"Plans \u0026 pricing","href":"/pricing","onBikesharefe":false},{"text":"Explore metro DC","href":"/explore","onBikesharefe":false},{"text":"System Map","href":"https://capitalbikeshare.com/#homepage_map","onBikesharefe":false},{"text":"Help","href":"https://help.capitalbikeshare.com/hc/en-us","onBikesharefe":false},{"text":"Capital Bikeshare for All","href":"https://capitalbikeshare.com/pricing/for-all","onBikesharefe":false}]},"footerLinks":{"componentType":"LinkList","id":"4k8LdTfPu0RnzsolAEq1cV","displayName":"Cabi: Footer Links","entries":[{"text":"System Map","href":"https://capitalbikeshare.com/#homepage_map","onBikesharefe":false},{"text":"Help","href":"https://help.capitalbikeshare.com/hc/en-us","onBikesharefe":false},{"text":"Pricing","href":"/pricing","onBikesharefe":false},{"text":"Bikes for Business","href":"https://capitalbikeshare.com/corporate","onBikesharefe":false},{"text":"Explore metro DC","href":"/explore","onBikesharefe":false},{"text":"Store","href":"https://store.capitalbikeshare.com/","onBikesharefe":false},{"text":"Blog","href":"https://capitalbikeshare.com/blog","onBikesharefe":false},{"text":"How it works","href":"/how-it-works","onBikesharefe":false},{"text":"System Data","href":"https://capitalbikeshare.com/system-data","onBikesharefe":false},{"text":"Suggest a station","href":"https://cabistationrequest.dc.gov/","onBikesharefe":false}]},"footerTinyLinks":{"componentType":"LinkList","id":"5DTFQYdZTlHnZaiv4kRWyn","displayName":"Capitalbike Footer Tiny Links","entries":[{"text":"Bicycle Rental Agreement \u0026 Liability Waiver","href":"https://cdn.lyft.com/static/terms-scooter-bike.html","onBikesharefe":false},{"text":"Privacy","href":"https://www.lyft.com/privacy","onBikesharefe":false}]},"headerLogInCta":"Log in","headerJoinCta":"Join","downloadAppHeader":"Download app","commonStrings":{"componentType":"bikeshareCommonStrings","id":"31LQNcqmRTGVZyok8VeTqe","title":"Standard Strings","headerLogInCta":"Log In","headerJoinCta":"Join","logOutCta":"Log out","greetingCta":"Hey there, {userName}","downloadAppHeader":"Download App","notFoundText":"Sorry, page not found","notFoundCta":"Return to Home","openNavigationMenu":"Open mobile navigation menu","closeNavigationMenu":"Close mobile navigation menu"}},"componentCookies":{},"query":{},"pathname":"/__tbs/capitalbikeshare/system-data","user":{},"brand":"CapitalBikeshare","domain":"capitalbikeshare.com","browserSessionId":"9869e922-4a77-4b0f-8425-d0262c1958faL1791783118"},"isTbsSite":true,"browserMetadata":{"deviceType":"desktop","viewportWidth":0,"trafficSource":"organic","browserSessionId":"9869e922-4a77-4b0f-8425-d0262c1958faL1791783118","devicePlatform":"Unknown"},"initialCmsData":{"footer":{"getRide":{"href":"https://lyft.sng.link/Adnq0/95a6?_dl=lyft%3A%2F%2F\u0026_smtype=3","text":"Get a ride"},"copyright":"© {{year}} Lyft, Inc.","cpucPermit":"CPUC ID No. TCP0032513-P","lyftColumn":{"links":[{"href":"/careers","text":"Careers"},{"href":"/lyftup/programs","text":"Lyft Up"},{"href":"/business","text":"Business"},{"href":"/healthcare","text":"Healthcare"},{"href":"/bikes","text":"Bikes"},{"href":"/scooters","text":"Scooters"},{"href":"/autonomous","text":"Autonomous"},{"href":"https://ads.lyft.com","text":"Lyft Ads"},{"href":"/venues-and-events","text":"Venue Partnerships"},{"href":"/developers","text":"Developers"},{"href