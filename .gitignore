# Build products
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.exe
*.obj
*.o
*.lib
*.dll
*.pdb

# Logs and transient run output
logs/
*.log
clone*.log
cplex.log

# Large/generated solver work directories.
# Keep top-level results/*.json and results/*.csv as reproducibility summaries.
results/*_work/
results/bound_work/
results/cplex_work/
results/gcap_work/
results/pricing_work/
results/tmp/

# Solver scratch files
*.lp
*.mps
*.mst
*.sol

# Local editor and OS files
.vscode/
.idea/
*.swp
*.tmp
Thumbs.db
Desktop.ini

# Round65 local evidence is indexed by hashes, not committed in full.
/results/gf_budgeted_proof_round65/local_raw/
/scripts/__pycache__/

# Round66 native evidence stays local; compact records carry hashes and paths.
/results/unified_exact_round66/local_raw/
!/results/unified_exact_round66/tests.log

/results/unified_exact_round67/local_raw/
!/results/unified_exact_round67/tests.log

# Small Round65 audit records required by submitted-only reproduction.
!/results/gf_budgeted_proof_round65/audit_final.log
!/results/gf_budgeted_proof_round65/tests/*.log
!/results/gf_budgeted_proof_round65/receipts/**/native.log
